# Supabase PostgreSQL connection (Transaction pooler — for serverless/Vercel)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL direct connection (for Prisma migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Storage (media upload)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="media"

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Site public URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://tetrisdesign.vn"

# Google Maps — Contact page (/contact)
# Phase 3 (khuyến nghị): Maps JavaScript API — pin Tetris, InfoWindow "Tetris", zoom bar +/−
# Cần bật "Maps JavaScript API" + billing trên Google Cloud Console
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-javascript-api-key"
# Tuỳ chọn: Map ID (Cloud Console → Maps → Map management). Cần cho AdvancedMarker pin custom.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="your-map-id"
#
# Fallback iframe (tuỳ chọn — khi chưa có API key ở trên; không có pin/zoom bar custom):
# Cách A: paste iframe src từ Google Maps → Share → Embed a map
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."
# Cách B: Maps Embed API key
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY="your-google-maps-embed-key"

# Behance profile (tuỳ chọn)
# NEXT_PUBLIC_BEHANCE_URL="https://www.behance.net/..."

# Single admin account — chọn MỘT trong hai cách bên dưới:

# Cách 1 (đơn giản): đặt mật khẩu trực tiếp
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-password-here"

# Cách 2 (bảo mật hơn): dùng bcrypt hash
# Tạo hash: node -e "const bcrypt=require('bcryptjs');bcrypt.hash('your-password',10).then(console.log)"
# LƯU Ý: phải escape ký tự $ bằng \$ trong file .env (Next.js sẽ làm hỏng hash nếu không escape)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD_HASH="\$2a\$10\$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy"
